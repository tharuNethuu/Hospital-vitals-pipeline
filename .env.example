# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Kafka / Confluent Cloud (same names Member A's producer already uses) ---
BOOTSTRAP_SERVER=
API_KEY=
API_SECRET=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL        # PLAINTEXT for a local, unsecured broker
# KAFKA_TOPIC=vitals-stream
# KAFKA_STARTING_OFFSETS=latest           # 'earliest' to backfill the master dataset from Kafka retention

# --- Postgres ---
# Leave unset to use the Postgres container from docker-compose.
# For Supabase (Settings -> Database): host, 5432 (or 6543 pooler), postgres, user, password, require
# PG_HOST=
# PG_PORT=5432
# PG_DB=postgres
# PG_USER=
# PG_PASSWORD=
# PG_SSLMODE=require
# Running scripts on the host against the compose Postgres:
#   PG_HOST=localhost PG_PORT=5433 PG_DB=hospital PG_USER=hospital PG_PASSWORD=hospital

# --- Simulated clock (must match lab_results_simulator.py) ---
# SIMULATED_DAY_SECONDS=120

# --- Tuning (defaults shown) ---
# WINDOW_DURATION=30 seconds
# WINDOW_SLIDE=10 seconds
# WATERMARK_DELAY=30 seconds
# BATCH_GRACE_SECONDS=10
# BATCH_MAX_FILES_PER_RUN=5
# LAB_FILE_MAX_AGE_SECONDS=21600
